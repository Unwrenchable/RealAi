# RealAI v3 stack env (copy values into shell or frontend .env.local)

# Inference (AMD Vulkan llama-server)
REALAI_VULKAN_BASE=http://127.0.0.1:8080
REALAI_DEFAULT_MODEL=qwen2.5-coder-7b-instruct-q5_k_m.gguf

# Orchestrator (UI points here)
ORCH_PORT=8001
REALAI_API_BASE=http://127.0.0.1:8001
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
REALAI_API_KEY=local

# Self-heal / self-improve (mutations)
REALAI_SELF_IMPROVE=true
# REALAI_SELF_HEAL_AUTO_APPLY=false

# Training gold (Phase 2)
REALAI_TRAINING_DATA=C:\realai\training\data

# Optional chat features (orchestrator)
# REALAI_MEMORY_INJECT=true
# REALAI_DEFAULT_AGENT_ID=
