{
  "version": 2,
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter realai-frontend build",
  "outputDirectory": "frontend/.next",
  "regions": ["iad1"],
  "functions": {
    "frontend/app/api/chat/route.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "frontend/app/api/models/route.ts": {
      "maxDuration": 15,
      "memory": 1024
    }
  }
}
