# ============================================================================
# Frontend (Vercel)
# ============================================================================
NEXT_PUBLIC_API_URL=https://realai-api.onrender.com
# Self-host declares provider realai (sent as X-Provider). Do not commit secrets.
NEXT_PUBLIC_PROVIDER=realai
# Optional alias for the same Hive/API base (used if NEXT_PUBLIC_API_URL is unset)
# NEXT_PUBLIC_REALAI_API=http://127.0.0.1:8001

# ============================================================================
# Backend (Render / FastAPI)
# ============================================================================
OPENAI_API_KEY=
REALAI_MODEL=realai-1.0
ENV=production
CORS_ALLOWED_ORIGINS=https://realai.vercel.app,https://your-custom-domain.com
PORT=8001
WEB_CONCURRENCY=1

# ============================================================================
# Deployment (Render/Vercel)
# ============================================================================
# Set these in Render and Vercel dashboard, not in .env
# - Render Health Check: /health
# - Render Timeout: 1000ms
# - Render Failure Threshold: 3

# ============================================================================
# Development (local)
# ============================================================================
REALAI_API_BASE=http://127.0.0.1:8001
# ============================================================================
# Database / Storage (optional)
# ============================================================================
# REALAI_DB_PATH: defaults to ~/.realai/conversations.db
# REALAI_DATA_DIR: defaults to ~/.realai

# ============================================================================
# Optional: Billing & Analytics
# ============================================================================
# BILLING_ENABLED=false
# ANALYTICS_ENABLED=false

# ============================================================================
# Optional: Training Pipeline
# ============================================================================
# TRAINING_DATASET_PATH=
# TRAINING_MODEL_NAME=realai-1.0

CORS_ALLOWED_ORIGINS=*
PORT=8001
# ============================================================================
# Local models / LoRA (canonical weight root)
# ============================================================================
REALAI_MODELS_DIR=C:\models\checkpoints_lora
REALAI_LORA_ROOT=C:\models\checkpoints_lora
# Datasets live under: %REALAI_MODELS_DIR%\datasets\normalized_datasets
# (junction also at %REALAI_MODELS_DIR%\normalized_datasets for older scripts)


# Hosted Next UI (Render redirects / here when set)
REALAI_PUBLIC_UI_URL=https://realaiui.vercel.app


# api_server: forward /v1/chat/completions to local Vulkan when healthy.
# Loopback Hive only — disabled on Render even if left at auto (force is Hive-only; hosted ignores it).
REALAI_VULKAN_BASE=http://127.0.0.1:8080
REALAI_VULKAN_FORWARD=auto

# When X-Provider=realai and no GGUF is loaded: use a cloud key (auto|off|<provider>)
# REALAI_CLOUD_FALLBACK=auto
