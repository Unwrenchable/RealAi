{
  "name": "realai-sft",
  "seed": 42,
  "eval_fraction": 0.1,
  "min_tokens": 8,
  "max_tokens": 1024,
  "near_dup_threshold": 0.85,
  "allow_vendor_chat": false,
  "tokenizer": "Qwen/Qwen2.5-1.5B-Instruct",
  "redact_usernames": [],
  "roots": {
    "realai": "C:/RealAI-clean",
    "repos": "C:/Users/<USER>/src"
  },
  "sources": [
    {
      "name": "provider_traces",
      "type": "jsonl",
      "license": "realai-own",
      "origin": "hive provider traces",
      "paths": [
        "{realai}/training/data/provider_traces/*.jsonl"
      ]
    },
    {
      "name": "hive_expand_run",
      "type": "hive_run_dir",
      "license": "realai-own",
      "min_grounding": 0.3,
      "paths": [
        "{realai}/training/data/provider_traces/_hive_expand_run"
      ]
    },
    {
      "name": "ability_surface",
      "type": "jsonl",
      "license": "realai-own",
      "paths": [
        "{realai}/training/data/ability_surface.jsonl"
      ]
    },
    {
      "name": "packA_coach",
      "type": "jsonl",
      "license": "realai-own",
      "paths": [
        "{realai}/training/data/packA_coach/packA_coach.jsonl"
      ]
    },
    {
      "name": "realai_finetune_dataset",
      "type": "jsonl",
      "license": "realai-own (model-assisted)",
      "paths": [
        "{realai}/training/data/realai_finetune_dataset.jsonl"
      ]
    },
    {
      "name": "self_builder_sessions",
      "type": "self_builder_sessions",
      "license": "realai-own",
      "require_success": true,
      "paths": [
        "{realai}/realai/datasets/processed/self_builder_sessions.jsonl"
      ]
    },
    {
      "name": "rackup_shots",
      "type": "rackup_shots",
      "license": "rackup-own",
      "origin": "Rack_em_up shot-catalog.ts",
      "convention": "Head = the break end; foot = the racking end. Left/right as you stand at the head rail facing the foot.",
      "paths": [
        "{repos}/Rack_em_up/rackup-backend/src/shots/shot-catalog.ts"
      ]
    },
    {
      "name": "sotd_maps",
      "type": "sotd_maps",
      "license": "rackup-own",
      "origin": "Rack_em_up sotd-shot-maps.ts geometry",
      "paths": [
        "{repos}/Rack_em_up/rackup-backend/src/realai/v2/sotd-shot-maps.ts"
      ],
      "catalog_paths": [
        "{repos}/Rack_em_up/rackup-backend/src/shots/shot-catalog.ts"
      ]
    },
    {
      "name": "rackup_rules",
      "type": "rackup_rules",
      "license": "realai-own",
      "origin": "realai/plugins/rackup_coach pyramid, leagues, league_validate"
    },
    {
      "name": "chess_stockfish",
      "type": "chess_stockfish",
      "license": "CC0-1.0 positions (Lichess puzzle database) + Stockfish 19 analysis (GPLv3 engine used as a local tool, not redistributed)",
      "origin": "Lichess puzzles CSV sample + local Stockfish",
      "attribution": "Positions and puzzle themes: Lichess puzzle database, https://database.lichess.org/ (CC0 1.0). Best moves, evaluations and lines computed locally with Stockfish 19 (https://stockfishchess.org/, GPLv3); the engine is used as a tool and is not part of this dataset.",
      "paths": [
        "{realai}/datasets/_sources/lichess_puzzles_sample.csv"
      ],
      "depth": 12,
      "limit": 1500
    },
    {
      "name": "device_profiles",
      "type": "device_profiles",
      "license": "realai-own (computed by realai/core/device_profile.recommend)",
      "origin": "mocked + local hardware reports",
      "include_local": false
    },
    {
      "name": "agency_import_thirdparty",
      "type": "agent_docs",
      "enabled": true,
      "license": "MIT (third-party: agency-agents)",
      "paths": [
        "{realai}/agents/agentx/agency_import.json",
        "{realai}/modules/agents_skills/agentx/agency_import.json",
        "{realai}/.agentx/agency_import.json"
      ],
      "origin": "msitarzewski/agency-agents via agentx/agency_import.json",
      "attribution": "Persona descriptions adapted from agency-agents (https://github.com/msitarzewski/agency-agents, checked at f99f6aa, 2026-10-07), Copyright (c) 2025 AgentLand Contributors, MIT License.",
      "license_file": "config/licenses/agency-agents-MIT.txt"
    },
    {
      "name": "agent_tools_agents",
      "type": "agent_docs",
      "license": "unwrenchable-own (agent-tools: owner proprietary/non-commercial; internal training OK, do not redistribute dataset)",
      "paths": [
        "{repos}/agent-tools/.agentx",
        "{repos}/agent-tools/.github/agents",
        "{repos}/agent-tools/agents",
        "{repos}/agent-tools/.github/copilot-instructions.md"
      ],
      "exclude": [
        "agency_import.json"
      ]
    },
    {
      "name": "afc_agents",
      "type": "agent_docs",
      "license": "unwrenchable-own",
      "paths": [
        "{repos}/ATOMIC-FIZZ-CAPS-VAULT-77-WASTELAND-GPS/.agentx",
        "{repos}/ATOMIC-FIZZ-CAPS-VAULT-77-WASTELAND-GPS/agents",
        "{repos}/ATOMIC-FIZZ-CAPS-VAULT-77-WASTELAND-GPS/.github/agents"
      ],
      "exclude": [
        "agency_import.json"
      ]
    },
    {
      "name": "realai_agents",
      "type": "agent_docs",
      "license": "realai-own",
      "paths": [
        "{realai}/agents/agentx",
        "{realai}/.github/agents",
        "{realai}/.github/instructions"
      ],
      "exclude": [
        "agency_import.json"
      ]
    },
    {
      "name": "persona_dump_filtered",
      "type": "filtered_text",
      "enabled": false,
      "license": "realai-own (Unwrenchable/RealAi, MIT) incl. agency-agents-derived personas (MIT)",
      "paths": [
        "{realai}/datasets/_sources/persona_dump.jsonl"
      ],
      "max_table_ratio": 0.2,
      "min_answer_chars": 80,
      "origin": "RealAi feature/ui-desktop-promote:dataset.jsonl",
      "attribution": "Persona descriptions adapted from agency-agents (https://github.com/msitarzewski/agency-agents, checked at f99f6aa, 2026-10-07), Copyright (c) 2025 AgentLand Contributors, MIT License.",
      "license_file": "config/licenses/agency-agents-MIT.txt"
    },
    {
      "name": "ide_chat_logs",
      "type": "ide_chat",
      "license": "third-party-vendor (excluded by default)",
      "paths": [
        "{realai}/docs_from_dotfolders/**/*.jsonl"
      ]
    }
  ],
  "notes": [
    "Licences checked 2026-10-10: agency-agents MIT (attribution in ATTRIBUTION.md); agent-tools is Travis's own non-commercial/proprietary repo; RealAi MIT."
  ]
}
