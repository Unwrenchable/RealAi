{
  "name": "realai-sft",
  "seed": 42,
  "eval_fraction": 0.1,
  "min_tokens": 8,
  "max_tokens": 1024,
  "near_dup_threshold": 0.85,
  "allow_vendor_chat": false,
  "tokenizer": "Qwen/Qwen2.5-1.5B-Instruct",
  "redact_usernames": [],
  "roots": {
    "realai": "C:/RealAI-clean",
    "repos": "C:/Users/<USER>/src"
  },
  "sources": [
    {"name": "provider_traces", "type": "jsonl", "license": "realai-own", "origin": "hive provider traces",
     "paths": ["{realai}/training/data/provider_traces/*.jsonl"]},
    {"name": "ability_surface", "type": "jsonl", "license": "realai-own",
     "paths": ["{realai}/training/data/ability_surface.jsonl"]},
    {"name": "packA_coach", "type": "jsonl", "license": "realai-own",
     "paths": ["{realai}/training/data/packA_coach/packA_coach.jsonl"]},
    {"name": "realai_finetune_dataset", "type": "jsonl", "license": "realai-own (model-assisted)",
     "paths": ["{realai}/training/data/realai_finetune_dataset.jsonl"]},
    {"name": "self_builder_sessions", "type": "self_builder_sessions", "license": "realai-own", "require_success": true,
     "paths": ["{realai}/realai/datasets/processed/self_builder_sessions.jsonl"]},
    {"name": "rackup_shots", "type": "rackup_shots", "license": "rackup-own", "origin": "Rack_em_up shot-catalog.ts",
     "convention": "Head = the break end; foot = the racking end. Left/right as you stand at the head rail facing the foot.",
     "paths": ["{repos}/Rack_em_up/rackup-backend/src/shots/shot-catalog.ts"]},
    {"name": "agent_tools_agents", "type": "agent_docs", "license": "unwrenchable-own",
     "paths": ["{repos}/agent-tools/.agentx", "{repos}/agent-tools/.github/agents", "{repos}/agent-tools/agents",
               "{repos}/agent-tools/.github/copilot-instructions.md"]},
    {"name": "afc_agents", "type": "agent_docs", "license": "unwrenchable-own",
     "paths": ["{repos}/ATOMIC-FIZZ-CAPS-VAULT-77-WASTELAND-GPS/.agentx", "{repos}/ATOMIC-FIZZ-CAPS-VAULT-77-WASTELAND-GPS/agents",
               "{repos}/ATOMIC-FIZZ-CAPS-VAULT-77-WASTELAND-GPS/.github/agents"]},
    {"name": "realai_agents", "type": "agent_docs", "license": "realai-own",
     "paths": ["{realai}/agents/agentx", "{realai}/.github/agents", "{realai}/.github/instructions"]},
    {"name": "persona_dump_filtered", "type": "filtered_text", "enabled": false, "license": "realai-own (generated)",
     "paths": ["{realai}/dataset.jsonl"], "max_table_ratio": 0.2, "min_answer_chars": 80},
    {"name": "ide_chat_logs", "type": "ide_chat", "license": "third-party-vendor (excluded by default)",
     "paths": ["{realai}/docs_from_dotfolders/**/*.jsonl"]}
  ]
}
